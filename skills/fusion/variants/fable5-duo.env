# fable5-duo — the zero-setup all-Claude harness (same as /fusion-fable5). Also the explicit form of the
# Opus 4.8 FALLBACK panel: detect_panel.sh auto-selects exactly this composition when codex/GPT-5.6 is
# unavailable.
#
# Fable 5 + Opus 4.8 panel via the claude CLI only; blind Fable 5 subprocess judges; the session
# synthesizes. No codex required — use when codex is unavailable/capped or you want an all-Claude run.
: "${FUSION_PANEL:=fable5,opus4.8}"
: "${FUSION_JUDGE:=fable5}"
: "${FUSION_CLAUDE_MODEL:=claude-fable-5}"
: "${FUSION_OPUS_MODEL:=opus}"
