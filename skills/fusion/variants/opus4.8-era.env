# opus4.8-era — the ORIGINAL harness, from before Fable 5 was generally available.
#
# Two independent Opus 4.8 cold runs, each loaded with the Fable 5 persona prompt (the pre-GA
# workaround), plus a GPT-5.5 panelist; GPT-5.5 judges; the session synthesizes. Preserved as a preset so
# the previous version of the harness stays one env var away — the same state is also frozen on the `dev`
# branch and the `era/opus4.8` tag for a full-repo checkout.
#
# Both claude panel tokens run as Opus here: FUSION_CLAUDE_MODEL pins the "fable5"-slot runner to opus,
# and FUSION_FABLE5_PROMPT re-enables the persona injection in run_claude.sh.
: "${FUSION_PANEL:=opus4.8,opus4.8,gpt5.5}"
: "${FUSION_JUDGE:=gpt5.5}"
: "${FUSION_CLAUDE_MODEL:=opus}"
: "${FUSION_OPUS_MODEL:=opus}"
: "${FUSION_FABLE5_PROMPT:=$SKILL_DIR/CLAUDE-FABLE-5.md}"
: "${CODEX_PANELIST_MODEL:=gpt-5.5}"
: "${JUDGE_MODEL:=gpt-5.5}"
